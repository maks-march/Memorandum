<?xml version="1.0" encoding="utf-8"?>
<!--
  Источник пакетов фиксирован явно: иначе на машине с корпоративным/приватным
  NuGet-фидом restore может не найти нужную версию пакета.
  Если в вашей сети nuget.org недоступен и используется зеркало — замените url.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
