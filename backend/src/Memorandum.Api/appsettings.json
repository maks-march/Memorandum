{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "Mock": {
    "Enabled": false
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "PasswordReset": {
    "MaxAttempts": 3,
    "CodeTimeToLive": "00:15:00",
    "ResendCooldown": "00:01:00",
    "CodePepper": ""
  },
  "Invitations": {
    "CodeTimeToLive": "1.00:00:00",
    "CodePepper": ""
  },
  "RateLimit": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60
  }
}
