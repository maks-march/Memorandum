{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "Mock": {
    "Enabled": false
  },
  "RateLimit": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60
  }
}
