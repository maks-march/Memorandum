{
  "Database": {
    "Provider": "Sqlite",
    "SqliteFile": "app.db"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=app.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "OpenApi": {
    "Enabled": true
  },
  "Mock": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173;http://127.0.0.1:5173"
  }
}
