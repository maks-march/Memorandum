# ─────────────────────────────────────────────────────────────────────────────
#  Прод-конфиг nginx в режиме TLS. Монтируется ПОВЕРХ
#  infra/nginx/default.conf.template (см. infra/docker-compose.tls.yml), поэтому
#  содержит всё нужное целиком: upstream, зону лимитов и два server-блока.
#
#  80  — только ACME-челлендж, /healthz и редирект на HTTPS
#  443 — приложение
#
#  envsubst подставит ${APP_HOST} при старте контейнера.
# ─────────────────────────────────────────────────────────────────────────────

upstream api_upstream {
    server api:8080 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=api_zone:10m rate=30r/s;

# ── HTTP: только редирект ────────────────────────────────────────────────────
server {
    listen 80;
    server_name ${APP_HOST};

    server_tokens off;

    # ACME-челлендж обязан отвечать по HTTP — до редиректа
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Техническая ручка для docker healthcheck web: после редиректа обычный
    # GET / вернул бы 301, и контейнер навсегда остался бы unhealthy.
    # Это не публичный монитор и не второй health API — только проба nginx.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS: приложение ────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_HOST};

    ssl_certificate     /etc/letsencrypt/live/${APP_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;
    server_tokens off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/plain text/css text/xml application/javascript application/json
        application/xml application/xml+rss image/svg+xml;

    # mock-эндпоинты в проде запрещены на уровне nginx
    location /mock/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/hsts.conf;
        return 404;
    }

    location /api/ {
        limit_req zone=api_zone burst=60 nodelay;
        proxy_pass http://api_upstream;          # URI не меняем: версия в пути (/api/v1/...)
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/hsts.conf;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/hsts.conf;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/hsts.conf;
        add_header Cache-Control "no-cache";
    }
}
