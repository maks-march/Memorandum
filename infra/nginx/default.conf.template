# Шаблон nginx для прода. envsubst подставит ${APP_HOST} при старте контейнера.
# Включает: раздачу SPA, прокси /api, запрет /mock, ACME-челлендж,
# gzip и базовые security-заголовки.

upstream api_upstream {
    # keepalive работает и с одним сервером; для нескольких реплик добавьте строки server
    server api:8080 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=api_zone:10m rate=30r/s;

server {
    listen 80;
    server_name ${APP_HOST} localhost;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;
    server_tokens off;

    # ── сжатие ───────────────────────────────────────────────────────────────
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/plain text/css text/xml application/javascript application/json
        application/xml application/xml+rss image/svg+xml;

    # ── security-заголовки ───────────────────────────────────────────────────
    # add_header не наследуется в location, где есть свой add_header, поэтому
    # snippet подключён в каждом location (а не только на уровне server).
    # HSTS намеренно не включён: он безопасен только при работающем HTTPS.
    include /etc/nginx/snippets/security-headers.conf;

    # ACME-челлендж (нужен и без TLS-профиля — не мешает)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # mock-эндпоинты в проде запрещены на уровне nginx
    location /mock/ {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    # API
    location /api/ {
        limit_req zone=api_zone burst=60 nodelay;
        proxy_pass http://api_upstream;          # URI не меняем: версия в пути (/api/v1/...)
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ассеты Vite — с хэшем в имени, можно кэшировать надолго
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, immutable";
    }

    # SPA
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }
}

