# Шаблон nginx для прода. envsubst подставит ${APP_HOST} при старте контейнера.
# Включает: раздачу SPA, прокси /api, запрет /mock, ACME-челлендж, healthz.
# Для HTTPS раскомментируйте блок 443 (нужен смонтированный том certs).

upstream api_upstream {
    least_conn;
    server api:8080 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=api_zone:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=login_zone:10m rate=10r/m;

server {
    listen 80;
    server_name ${APP_HOST} localhost;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;
    server_tokens off;

    # ACME-челлендж (нужен и без TLS-профиля — не мешает)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # для healthcheck'а compose и балансировщика
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # mock-эндпоинты в проде запрещены на уровне nginx
    location /mock/ {
        return 404;
    }

    # API
    location /api/ {
        limit_req zone=api_zone burst=60 nodelay;
        proxy_pass http://api_upstream;          # URI не меняем: контроллеры уже на /api/...
        include /etc/nginx/snippets/proxy.conf;
    }

    # ассеты Vite — с хэшем в имени, можно кэшировать надолго
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}

