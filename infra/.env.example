# cp .env.example .env  →  отредактировать  →  chmod 600 .env
# Этот файл читает только docker-compose.prod.yml (--env-file infra/.env).
# В dev ничего не нужно: docker compose -f infra/docker-compose.dev.yml up.
#
# Секреты (пароль БД, пароль Redis, соль кодов) prod-up.sh генерирует сам.
# Ниже — значения-заглушки: с ними стек поднимется, но перед реальным
# запуском их надо заменить.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=memorandum
POSTGRES_USER=memorandum
POSTGRES_PASSWORD=change-me-strong

# ─── Redis (коды смены пароля) ───────────────────────────────────────────────
# Обязателен: compose не поднимется без него. Снаружи Redis не публикуется.
# Сгенерировать: openssl rand -base64 24 | tr -d '/+='
REDIS_PASSWORD=change-me-redis

# Соль для хеша кода (HMAC-SHA256, в Redis лежит только хеш). Обязательна:
# API в Production не стартует без неё. Смена соли обнуляет все выданные коды.
# Сгенерировать: openssl rand -base64 32
# соль для HMAC кодов: смена пароля и коды приглашения (общий секрет)
PASSWORD_RESET_PEPPER=change-me-pepper

# ─── Почта (SMTP) ────────────────────────────────────────────────────────────
# Письма отправляет сам API: отдельного почтового сервиса в стеке нет.
# Обязательны для Production: без SMTP_HOST и SMTP_FROM API не стартует.
# В dev те же значения читает docker-compose.dev.yml; не заданы — письма
# печатаются в лог API с предупреждением.
# Порт 587 (STARTTLS). Неявный TLS 465 штатным SmtpClient не поддерживается.
SMTP_HOST=smtp.example.ru
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=no-reply@example.ru
SMTP_PASSWORD=change-me-smtp
# Отправитель в формате «Имя <адрес>»
SMTP_FROM=Memorandum <no-reply@example.ru>

# ─── Образы (GHCR) ───────────────────────────────────────────────────────────
# Нужны для деплоя на VPS (docker compose pull). Локально подставляйте свои имена.
API_IMAGE=ghcr.io/maks-march/memorandum-api
WEB_IMAGE=ghcr.io/maks-march/memorandum-web
IMAGE_TAG=stable

# ─── Сеть ────────────────────────────────────────────────────────────────────
# Домен или IP сервера: попадает в AllowedHosts и в server_name у nginx.
# '*' запрещён — API падает на старте.
APP_HOST=localhost
# Порт, на который web публикуется наружу (smoke в CD берёт его отсюда).
WEB_PORT=80