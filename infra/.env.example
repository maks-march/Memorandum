# cp .env.example .env  →  отредактировать  →  chmod 600 .env
# Этот файл — только для docker-compose.prod.yml. В dev ничего не нужно.

POSTGRES_DB=memorandum
POSTGRES_USER=memorandum
POSTGRES_PASSWORD=change-me-strong

# Образы из GHCR — нужны для деплоя на VPS (docker compose pull).
# Локально prod-up.sh подставляет IMAGE_TAG=local.
API_IMAGE=ghcr.io/maks-march/memorandum-api
WEB_IMAGE=ghcr.io/maks-march/memorandum-web
IMAGE_TAG=stable

# домен сервера: для TLS и server_name. Без домена оставьте localhost
APP_HOST=localhost
# порт, на который web публикуется наружу (smoke в CD берёт его отсюда)
WEB_PORT=80
# e-mail для Let's Encrypt (нужен только с профилем tls)
CERTBOT_EMAIL=admin@example.ru
