# cp .env.example .env  →  отредактировать  →  chmod 600 .env
# Этот файл — только для docker-compose.prod.yml. В dev ничего не нужно.

POSTGRES_DB=memorandum
POSTGRES_USER=memorandum
POSTGRES_PASSWORD=change-me-strong

# Образы из GHCR — нужны для деплоя на VPS (docker compose pull).
# IMAGE_TAG=local или флаг "./infra/prod-up.sh --local" — собрать образы
# на месте из этого checkout (версия в бейдже берётся из git sha).
API_IMAGE=ghcr.io/maks-march/memorandum-api
WEB_IMAGE=ghcr.io/maks-march/memorandum-web
IMAGE_TAG=stable

# домен сервера: для TLS и server_name. Без домена оставьте localhost
APP_HOST=localhost
# порт, на который web публикуется наружу (smoke в CD берёт его отсюда)
WEB_PORT=80
# e-mail для Let's Encrypt (нужен только в TLS-режиме)
CERTBOT_EMAIL=admin@example.ru
# host-порт для 443: попадает в редирект 80 → 443 (https://APP_HOST:HTTPS_PORT)
# и в smoke. Оставьте 443, если не публикуете HTTPS на нестандартном порту.
HTTPS_PORT=443

# TLS-режим: 1 — web поднимается с оверрайдом docker-compose.tls.yml (443,
# сертификаты, certbot, редирект 80 → 443). Ставит ./infra/prod-up.sh --tls,
# читают и скрипт, и CD — иначе деплой пересоздаст web без TLS.
# При TLS_ENABLED=1 prod-up.sh сам ставит в cron reload-certs.sh (04:00):
# без reload nginx держит старый сертификат в памяти, пока тот не истечёт.
TLS_ENABLED=0
